{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "model_version": { "type": "string" },
    "artifact_schema_version": { "type": "integer", "const": 2 },
    "model_uri": { "type": "string", "format": "uri" },
    "sha256": { "type": "string" },
    "snapshot_id": { "type": "string" },
    "snapshot_sha256": { "type": "string" },
    "mlflow_run_id": { "type": "string" },
    "registry_version": { "type": "string" },
    "git_sha": { "type": "string" },
    "training_image_digest": { "type": "string" }
  },
  "required": [
    "model_version",
    "artifact_schema_version",
    "model_uri",
    "sha256",
    "snapshot_id",
    "snapshot_sha256",
    "mlflow_run_id",
    "registry_version",
    "git_sha",
    "training_image_digest"
  ]
}
