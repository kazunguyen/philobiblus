# Copy this file to .env before running Docker Compose.
# Every network URL, host and port is deployment configuration; the application
# intentionally has no fallback values for these settings.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=philobiblus_db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://postgres:replace-with-a-local-password@db:5432/philobiblus_db
IMGBB_API=

SECRET_KEY=replace-with-a-long-random-jwt-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

APP_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_HOST_PORT=8000

VITE_API_URL=/api
VITE_DEV_HOST=0.0.0.0
FRONTEND_PORT=5173
FRONTEND_HOST_PORT=5173

NGINX_PORT=80
NGINX_HOST_PORT=80
NGINX_SERVER_NAME=localhost
BACKEND_SERVICE_HOST=backend
FRONTEND_SERVICE_HOST=frontend
