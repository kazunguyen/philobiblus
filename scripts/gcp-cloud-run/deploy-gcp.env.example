# Copy to a local file, then source it before running deploy scripts.
# Do not commit the copied file.

export PROJECT_ID="your-gcp-project-id"
export REGION="asia-southeast1"
export ENVIRONMENT="dev"

export DOCKERHUB_USERNAME="your-dockerhub-username"
export FRONTEND_ORIGIN="https://your-user.github.io"
export FRONTEND_REF="main"

# Optional. If omitted, terraform-configure.sh uses the active gcloud account.
# export ALERT_EMAIL="operator@example.com"

# Optional. Prefer an interactive docker login instead of storing a token here.
# export DOCKERHUB_TOKEN=""
